# ================================
# CareConnex Environment Variables
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============ FIREBASE (Client-side, Vite) ============
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============ STRIPE (Client-side) ============
# Get from Stripe Dashboard > Developers > API Keys
# Use pk_test_xxx for development, pk_live_xxx for production
VITE_STRIPE_PUBLIC_KEY=

# ============ GEMINI AI ============
# Get from Google AI Studio: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ============ TWILIO VIDEO (Client-side tokens) ============
# Get from Twilio Console > Account > API Keys
# Used for generating video tokens client-side (dev only)
# In production, these should be server-side only
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_API_KEY_SID=
VITE_TWILIO_API_KEY_SECRET=

# ============ FEATURE FLAGS ============
VITE_USE_MOCKS=false

# ================================
# SERVER-SIDE / CLOUD FUNCTIONS
# ================================
# These are NOT exposed to the client (no VITE_ prefix)
# Set via Firebase Functions config or environment secrets

# Stripe (server-side)
# firebase functions:secrets:set STRIPE_SECRET_KEY
# STRIPE_SECRET_KEY=sk_live_xxx

# Twilio SMS (server-side)
# firebase functions:config:set twilio.account_sid="ACxxx" twilio.auth_token="xxx" twilio.phone_number="+1xxxxxxxxxx"

# Checkr Background Checks (if using)
# firebase functions:config:set checkr.api_key="xxx"
